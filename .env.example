# ===== Deutsch Lernen — biến môi trường (copy sang .env, KHÔNG commit .env) =====

# --- Web (Next.js) ---
# Public (an toàn để lộ ra client):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# SERVER-ONLY (chỉ đọc trong Route Handler — KHÔNG bao giờ ở client/extension):
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# --- Extension (inject lúc build qua env, chỉ giá trị PUBLIC) ---
EXT_SUPABASE_URL=
EXT_SUPABASE_ANON_KEY=
EXT_APP_URL=http://localhost:3000
